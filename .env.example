# Copy to `.env` for local development, and set the same variable in the
# Vercel project settings (Settings -> Environment Variables) for production.
#
# Local development (backend running via `npm run start` in SCMS-Back-end):
VITE_API_BASE_URL=https://scms-backend-dusky.vercel.app/
# http://localhost:5000/api

# Production: point at the deployed backend project, e.g.
# VITE_API_BASE_URL=https://scms-backend-dusky.vercel.app/api

# Optional. The Google sign-in button reads its client id from the back end
# (GET /api/public/config, driven by GOOGLE_CLIENT_ID), so this is only needed
# if you ever want to render the button without asking the server first.
# VITE_GOOGLE_CLIENT_ID=
